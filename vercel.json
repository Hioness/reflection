{
  "cleanUrls": true,
  "rewrites": [{ "source": "/", "destination": "/index.html" }],
  "redirects": [
    { "source": "/split-view.html", "destination": "/annual", "permanent": true },
    { "source": "/split-view", "destination": "/annual", "permanent": true },
    { "source": "/mobile.html", "destination": "/annual", "permanent": true },
    { "source": "/mobile", "destination": "/annual", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/([^/]+\\.svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/favicon.ico",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
